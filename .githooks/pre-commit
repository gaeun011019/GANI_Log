#!/bin/zsh

set -u

repo_dir=$(/usr/bin/git rev-parse --show-toplevel)
change_log="$repo_dir/AUTO_CHANGELOG.md"

if /usr/bin/git diff --cached --quiet -- . ':(exclude)AUTO_CHANGELOG.md'; then
  exit 0
fi

change_fingerprint=$(/usr/bin/git diff --cached --binary -- . ':(exclude)AUTO_CHANGELOG.md' | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')
if /usr/bin/grep -Fq "<!-- change-id: $change_fingerprint -->" "$change_log"; then
  exit 0
fi

timestamp=$(/bin/date '+%Y-%m-%d %H:%M:%S')
change_status=$(/usr/bin/git -c core.quotePath=false diff --cached --name-status -- . ':(exclude)AUTO_CHANGELOG.md')
change_stat=$(/usr/bin/git -c core.quotePath=false diff --cached --stat -- . ':(exclude)AUTO_CHANGELOG.md')
change_count=$(/bin/echo "$change_status" | /usr/bin/awk 'NF { count++ } END { print count + 0 }')

{
  /bin/echo
  /bin/echo "## $timestamp"
  /bin/echo
  /bin/echo "### 변경 요약"
  /bin/echo
  /bin/echo "- ${change_count}개 파일의 변경 내용을 저장했습니다."
  /bin/echo
  /bin/echo "### 변경된 파일"
  /bin/echo
  while IFS=$'\t' read -r file_status path extra_path; do
    case "$file_status" in
      A) label="추가" ;;
      M) label="수정" ;;
      D) label="삭제" ;;
      R*) label="이름 변경" ;;
      *) label="$file_status" ;;
    esac
    if [[ -n "${extra_path:-}" ]]; then
      /bin/echo "- $label: \`$path\` → \`$extra_path\`"
    else
      /bin/echo "- $label: \`$path\`"
    fi
  done <<< "$change_status"
  /bin/echo
  /bin/echo "<details>"
  /bin/echo "<summary>파일별 변경 규모 보기</summary>"
  /bin/echo
  /bin/echo '```text'
  /bin/echo "$change_stat"
  /bin/echo '```'
  /bin/echo
  /bin/echo "</details>"
  /bin/echo
  /bin/echo "<!-- change-id: $change_fingerprint -->"
} >> "$change_log"

/usr/bin/git add AUTO_CHANGELOG.md
