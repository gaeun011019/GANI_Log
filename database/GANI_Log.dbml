Project GANI_Log {
  Note: '다이브 컴퓨터 기록, 직접 입력 정보, 개인 장비와 SAC·RMV 분석을 관리하는 GANI Log 데이터 모델'
}

Enum import_method {
  bluetooth
  file
  manufacturer_account
}

Enum import_status {
  pending
  processing
  completed
  failed
}

Enum equipment_category {
  suit
  bcd
  regulator
  fins
  mask
  dive_computer
  other
}

Enum equipment_source {
  personal
  rental
}

Enum water_type {
  sea
  fresh
}

Enum current_strength {
  none
  weak
  moderate
  strong
}

Enum condition_level {
  low
  moderate
  high
}

Enum weight_assessment {
  light
  appropriate
  heavy
}

Enum log_visibility {
  private
  friends
  public
}

Enum friendship_status {
  pending
  accepted
}

Table users {
  id bigint [pk, increment]
  email varchar(255) [not null, unique, note: '로그인 이메일']
  password_hash varchar(255) [not null, note: '평문 비밀번호 저장 금지']
  name varchar(100) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '사용자 계정과 기본 프로필'
}

Table user_certifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  certification_name varchar(150) [not null, note: '사용자가 직접 등록한 자격명']
  issuer varchar(100)
  issued_on date
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id
    (user_id, certification_name) [unique]
  }

  Note: '한 사용자가 보유한 다이빙 자격 목록'
}

Table dive_computers {
  id bigint [pk, increment]
  user_id bigint [not null]
  manufacturer varchar(100)
  model_name varchar(150) [not null]
  serial_number varchar(150)
  is_active boolean [not null, default: true]
  connected_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    user_id
    (user_id, serial_number) [unique]
  }

  Note: '사용자가 등록하거나 연동한 다이브 컴퓨터'
}

Table import_sessions {
  id bigint [pk, increment]
  user_id bigint [not null]
  dive_computer_id bigint
  method import_method [not null]
  status import_status [not null, default: 'pending']
  original_file_name varchar(255)
  mime_type varchar(150) [note: 'FIT, CSV 또는 이미지 MIME 유형']
  file_size_bytes bigint
  error_message text
  started_at timestamp [not null, default: `now()`]
  completed_at timestamp

  indexes {
    user_id
    dive_computer_id
    (user_id, started_at)
  }

  Note: '블루투스·파일·제조사 계정으로 기록을 가져온 처리 이력. 이미지 OCR 결과 구조는 추후 확정한다.'
}

Table dive_logs {
  id bigint [pk, increment]
  user_id bigint [not null]
  import_session_id bigint
  dive_point varchar(200) [not null]
  country_code char(2) [note: 'ISO 3166-1 alpha-2']
  region varchar(150)
  dived_on date [not null]
  started_at timestamp
  duration_minutes int [not null, check: `duration_minutes > 0`]
  average_depth_m decimal(5,2) [not null, check: `average_depth_m >= 0`]
  maximum_depth_m decimal(5,2) [not null, check: `maximum_depth_m >= average_depth_m`]
  water_temperature_c decimal(4,1)
  memo text
  visibility log_visibility [not null, default: 'private', note: 'private: 작성자만, friends: 친구만, public: 전체 공개']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    user_id
    import_session_id
    (user_id, dived_on)
    (user_id, dive_point)
  }

  Note: '다이빙 1회에 대한 기본 로그. 같은 사용자·일시의 중복 가능성은 저장 전에 확인한다.'
}

Table friendships {
  id bigint [pk, increment]
  requester_id bigint [not null]
  addressee_id bigint [not null]
  status friendship_status [not null, default: 'pending']
  created_at timestamp [not null, default: `now()`]
  accepted_at timestamp

  indexes {
    requester_id
    addressee_id
    (requester_id, addressee_id) [unique]
  }

  checks {
    `requester_id <> addressee_id` [name: 'cannot_friend_self']
  }

  Note: '로그를 공유할 사용자 간 친구 요청과 수락 상태'
}

Table dive_log_buddies {
  dive_log_id bigint [not null]
  buddy_user_id bigint [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (dive_log_id, buddy_user_id) [pk]
    buddy_user_id
  }

  Note: '해당 다이빙에 함께한 로그인 사용자. 수락된 친구만 버디로 지정할 수 있다.'
}

Table dive_gas_metrics {
  dive_log_id bigint [pk]
  tank_volume_l decimal(5,2) [not null, default: 11, check: `tank_volume_l > 0`]
  start_pressure_bar decimal(6,2) [not null, check: `start_pressure_bar > 0`]
  end_pressure_bar decimal(6,2) [not null, check: `end_pressure_bar >= 0`]
  sac_bar_per_min decimal(7,3) [note: '표면 기준 탱크 압력 소비율']
  rmv_l_per_min decimal(7,3) [note: '표면 기준 호흡 기체량']
  calculated_at timestamp

  checks {
    `end_pressure_bar < start_pressure_bar` [name: 'valid_pressure_range']
  }

  Note: 'SAC·RMV 계산 입력값과 결과. 평균 수심과 시간은 dive_logs에서 참조한다.'
}

Table dive_conditions {
  dive_log_id bigint [pk]
  water water_type
  current current_strength
  visibility_m decimal(5,1) [check: `visibility_m >= 0`]
  activity_level condition_level
  tension_level condition_level

  Note: '유사 조건 로그 비교에 사용하는 환경·활동·긴장 상태'
}

Table dive_weighting {
  dive_log_id bigint [pk]
  weight_kg decimal(5,2) [not null, check: `weight_kg >= 0`]
  assessment weight_assessment

  Note: '웨이트 무게와 사용자의 상태 평가. 추천값이 아니라 과거 기록 비교용이다.'
}

Table equipment {
  id bigint [pk, increment]
  user_id bigint [not null]
  name varchar(150) [not null]
  category equipment_category [not null]
  subtype varchar(100) [not null, note: '예: 웻슈트, 드라이슈트, 조끼형 BCD, 프레임리스 마스크']
  is_active boolean [not null, default: true, note: '삭제 대신 비활성화하여 과거 로그 연결을 보존']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    user_id
    (user_id, name) [unique]
    (user_id, category)
  }

  Note: '사용자가 장비 관리 화면에서 등록한 개인 장비'
}

Table dive_log_equipment {
  id bigint [pk, increment]
  dive_log_id bigint [not null]
  equipment_id bigint [note: '렌탈 장비이면 null']
  source equipment_source [not null]
  equipment_name_snapshot varchar(150) [not null, note: '장비가 수정·삭제되어도 당시 이름 유지']
  category_snapshot equipment_category [not null]
  subtype_snapshot varchar(100)

  indexes {
    dive_log_id
    equipment_id
    (dive_log_id, equipment_name_snapshot) [unique]
  }

  Note: '로그 작성 당시 사용한 개인 또는 렌탈 장비. 다대다 관계와 이력 보존을 함께 처리한다.'
}

Ref fk_certification_user: users.id < user_certifications.user_id [delete: cascade]
Ref fk_computer_user: users.id < dive_computers.user_id [delete: cascade]
Ref fk_import_user: users.id < import_sessions.user_id [delete: cascade]
Ref fk_import_computer: dive_computers.id < import_sessions.dive_computer_id [delete: set null]
Ref fk_log_user: users.id < dive_logs.user_id [delete: cascade]
Ref fk_friend_requester: users.id < friendships.requester_id [delete: cascade]
Ref fk_friend_addressee: users.id < friendships.addressee_id [delete: cascade]
Ref fk_buddy_log: dive_logs.id < dive_log_buddies.dive_log_id [delete: cascade]
Ref fk_buddy_user: users.id < dive_log_buddies.buddy_user_id [delete: cascade]
Ref fk_log_import: import_sessions.id < dive_logs.import_session_id [delete: set null]
Ref fk_gas_log: dive_logs.id - dive_gas_metrics.dive_log_id [delete: cascade]
Ref fk_condition_log: dive_logs.id - dive_conditions.dive_log_id [delete: cascade]
Ref fk_weight_log: dive_logs.id - dive_weighting.dive_log_id [delete: cascade]
Ref fk_equipment_user: users.id < equipment.user_id [delete: cascade]
Ref fk_log_equipment_log: dive_logs.id < dive_log_equipment.dive_log_id [delete: cascade]
Ref fk_log_equipment_item: equipment.id < dive_log_equipment.equipment_id [delete: set null]
